.claude/settings.local.json

# local run logs
streamlit*.log

# generated: white paper copied from docs/whitepaper.html for Streamlit static serving
frontend/static/

# submission build artifacts (zips generated for the JotForm upload)
FTU-VeriTrade_*.zip




# UI/UX Pro Max skill — vendored tooling, reinstall with:
