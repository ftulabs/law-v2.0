# ── VeriTrade configuration ──────────────────────────────────────────────
# Everything has a safe default. With NO keys set, the pipeline runs in
# "mock mode" end-to-end so demos never depend on a network call.

# --- Providers (modular: swap without touching code) ---
OCR_PROVIDER=markitdown    # markitdown (default) | tesseract | paddle | azure | mock
LLM_PROVIDER=openrouter    # openrouter | anthropic | openai | local | mock

# --- OpenRouter (free models) ---
# Get a key at https://openrouter.ai/keys and paste it here in your LOCAL .env
# (this file, .env.example, is committed; your real .env is gitignored).
# For a deployed web app, set OPENROUTER_API_KEY in the platform's Secrets instead.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# good free options: qwen/qwen3-next-80b-a3b-instruct:free | openai/gpt-oss-120b:free |
#                    z-ai/glm-4.5-air:free | nvidia/nemotron-3-super-120b-a12b:free

# --- Other LLM providers (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Self-hosted / local LLM (only if LLM_PROVIDER=local) ---
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, llama.cpp, LocalAI…
# Point at the server's /v1. For Ollama on a lab box, use its host + port 11434:
LOCAL_LLM_BASE_URL=http://localhost:11434/v1   # e.g. http://gpu-lab.myuni.edu:11434/v1
LOCAL_LLM_MODEL=llama3.1                        # a model the server serves (run `ollama list`)
LOCAL_LLM_API_KEY=                              # leave blank for Ollama; set only if a gateway needs it

# --- Azure OCR (only if OCR_PROVIDER=azure) ---
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Tesseract (only if OCR_PROVIDER=tesseract) ---
TESSERACT_CMD=             # e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
POPPLER_PATH=              # e.g. C:\poppler\bin  (for pdf2image)

# --- Confidence routing thresholds ---
CONF_AUTO_ACCEPT=0.85      # >= → auto accept
CONF_REVIEW_FLOOR=0.60     # 0.60–0.84 → human review;  < floor → quarantine

# --- Storage / outputs ---
VERITRADE_DB=outputs/veritrade.db
OUTPUT_DIR=outputs

# --- Crawl / fetch (Zone 1 live discovery: python main.py --live) ---
# Default UA is browser-like to get past portal bot blocks (SG SSO 403s unknown agents).
# CRAWL_USER_AGENT=VeriTrade-Research/0.2 (+hackathon; contact: minhtc.ftu@gmail.com)
CRAWL_ACCEPT_LANGUAGE=en,ms;q=0.8
CRAWL_DELAY_SECONDS=2          # polite gap between hits to the SAME host
CRAWL_TIMEOUT_SECONDS=30
CACHE_DIR=data/cache          # downloaded law bodies (content-hashed, deduped)
FETCH_MAX_BYTES=60000000      # 60MB hard cap per document
DISCOVERY_MAX_DOCS=12         # candidate cap per (economy, pillar)
DISCOVERY_MAX_PAGES=1         # search-result pages to walk per query

# --- Retrieval (Zone 1 ranking) ---
DENSE_RETRIEVAL=auto          # auto | on | off  (auto = use embeddings if installed)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HYBRID_ALPHA=0.5              # final = alpha*BM25 + (1-alpha)*dense
