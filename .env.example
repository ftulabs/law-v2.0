# ── VeriTrade configuration ──────────────────────────────────────────────
# Everything has a safe default. With NO keys set, the pipeline runs in
# "mock mode" end-to-end so demos never depend on a network call.

# --- Providers (modular: swap without touching code) ---
OCR_PROVIDER=rapidocr      # rapidocr (default) | paddle | tesseract | azure | markitdown | mock
                           # per-language model is chosen automatically from the economy;
                           # see docs/OCR_LANGUAGE_EVIDENCE.md
LLM_PROVIDER=openrouter    # openrouter | gemini | anthropic | openai | local | mock

# --- Google Gemini (only if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=            # from Google AI Studio; NEVER commit a real key
GEMINI_MODEL=gemini-2.0-flash

# --- OpenRouter (paid models — default) ---
# Get a key at https://openrouter.ai/keys and ADD CREDITS, then paste it in your LOCAL .env
# (this file, .env.example, is committed; your real .env is gitignored).
# For a deployed web app, set OPENROUTER_API_KEY in the platform's Secrets instead.
# The `:free` tier was dropped from the default path — it 429s on free-models-per-day even
# with a funded key.
OPENROUTER_API_KEY=
# Default grader = declared engine A, deepseek-v4-flash (open weight, ~$0.19 per 1,000 grading
# calls). 28/28 on a 28-row bench of real rows (16 panel answers, 12 known-wrong) with
# reasoning OFF. Declared engine B is google/gemini-3.7-flash (closed). See README.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# Reasoning for hybrid models: "" = the model's own default, off, low, medium, high.
# Off by default: with it on, deepseek-v4-flash scored 19-20/28 and took up to 198 s a call.
OPENROUTER_REASONING=off
# Second-pass check of every ACCEPTED row by quotation. Empty = the grader's own model.
# deepseek-v4-pro-0813 kept 48/48 right rows and refused 31/36 wrong ones (flash: 20/36).
VERIFY_ENABLED=true
VERIFY_MODEL=deepseek/deepseek-v4-pro-0813
# other paid models: google/gemini-3.7-flash | google/gemini-2.5-flash | openai/gpt-4o-mini | google/gemini-2.5-flash-lite

# --- Other LLM providers (optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Self-hosted / local LLM (only if LLM_PROVIDER=local) ---
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, llama.cpp, LocalAI…
# One endpoint, or several comma-separated when a cluster serves the same model from
# interchangeable nodes — calls are handed out round-robin and a node that fails is
# dropped from the rotation. Measured 2026-09-07: 1 node ~19s/grading call, 11 nodes 634/hour.
# The values below are a plain local Ollama, so a fresh clone works with `ollama serve`.
# Our own team server is a private host and its address and key stay in `.env`, never here:
# this file ships in a public repository and a default nobody else can reach is worse than
# no default at all.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1  # Ollama's default; point it at your own endpoint
LOCAL_LLM_MODEL=llama3.1                      # `curl -H "Authorization: Bearer $KEY" $BASE/v1/models` to list ids
LOCAL_LLM_API_KEY=                            # blank for Ollama / no-auth vLLM; set it for a keyed endpoint

# --- Azure OCR (only if OCR_PROVIDER=azure) ---
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# --- Tesseract (only if OCR_PROVIDER=tesseract) ---
# e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
# e.g. C:\poppler\bin  (for pdf2image)
POPPLER_PATH=

# --- Confidence routing thresholds ---
CONF_AUTO_ACCEPT=0.85      # >= → auto accept
CONF_REVIEW_FLOOR=0.60     # 0.60–0.84 → human review;  < floor → quarantine

# --- Sign-in ---
# On by default: the first visit asks you to Create account. Set false for a single-user demo.
AUTH_ENABLED=true

# --- Storage / outputs ---
VERITRADE_DB=outputs/veritrade.db
OUTPUT_DIR=outputs

# --- Crawl / fetch (Zone 1 live discovery: python main.py --live) ---
# Default UA is browser-like to get past portal bot blocks (SG SSO 403s unknown agents).
# CRAWL_USER_AGENT=VeriTrade-Research/0.2 (+hackathon; contact: minhtc.ftu@gmail.com)
CRAWL_ACCEPT_LANGUAGE=en,ms;q=0.8
CRAWL_DELAY_SECONDS=2          # polite gap between hits to the SAME host
CRAWL_TIMEOUT_SECONDS=30
CACHE_DIR=data/cache          # downloaded law bodies (content-hashed, deduped)
FETCH_MAX_BYTES=60000000      # 60MB hard cap per document
DISCOVERY_MAX_DOCS=22         # candidate cap per (economy, pillar) — the code default
DISCOVERY_MAX_PAGES=1         # search-result pages to walk per query

# --- Web-search discovery (optional; not used by the portal adapters) ---
# Every economy is now discovered through its own portal adapter, so no search key is needed.
# Keyless scraping (DuckDuckGo/Mojeek) rate-limits; a Serper key (serper.dev) gives reliable
# Google deep-links. 2,500 credits free, then $1/1k (1 credit/query; ~185 queries per full
# Round-1 crawl). Leave blank to use the free keyless fallback + on-disk cache.
SERPER_API_KEY=
# Sample kit (RDTII Round-1 Database) for KNOWN/NEW tagging. Blank = auto-discover
# data/sample_kit/*.csv. KNOWN = law was a sample example; NEW = found independently.
SAMPLE_KIT_PATH=

# --- Retrieval (Zone 1 ranking) ---
DENSE_RETRIEVAL=auto          # auto | on | off  (auto = use embeddings if installed)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HYBRID_ALPHA=0.65             # final = alpha*BM25 + (1-alpha)*dense — MEASURED, see docs/retrieval-redesign.md
